<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sized to match the standard adaptive-icon canvas (108dp) rather
         than 1dp: some Android 12+ OEM SplashScreen implementations
         reject/rescale drawables that fall outside the expected icon
         size and silently fall back to the launcher icon instead. -->
    <size android:width="108dp" android:height="108dp"/>
    <solid android:color="@android:color/transparent"/>
</shape>